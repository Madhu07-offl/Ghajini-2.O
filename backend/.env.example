PROJECT_NAME="Ghajini 2.0"
API_V1_STR="/v1"
DATABASE_URL="sqlite:///./ghajini.db"

# Face engine similarity thresholds
FACE_T_HIGH=0.50
FACE_T_LOW=0.38

# Ollama LLM Settings
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2:3b"
OLLAMA_TEMPERATURE=0.2
OLLAMA_MAX_TOKENS=120
OLLAMA_TIMEOUT_SECONDS=15.0

# Whisper Settings
WHISPER_MODEL="small"

# Feature Flags & Caregiver Alerts
FEATURE_PUSH=false
FEATURE_SMS=false
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
CAREGIVER_PHONE="+919876543210"

# LLM Provider Switch (Ollama local / OpenRouter free tier)
LLM_PROVIDER="ollama"               # "ollama" | "openrouter"
OPENROUTER_API_KEY=""              # Free key from openrouter.ai
OPENROUTER_MODEL="meta-llama/llama-3.2-3b-instruct:free" # Must end with :free

# Free Telegram Caregiver Briefing
FEATURE_TELEGRAM=false
TELEGRAM_BOT_TOKEN=""              # From @BotFather on Telegram
TELEGRAM_CHAT_ID=""                # Caregiver chat ID

# Optional Video Room
VIDEO_LINK_BASE_URL=""             # e.g. "https://meet.jit.si"

# Privacy Controls
STORE_PHOTOS=false

# Reminder & Escalation Settings
ESCALATE_AFTER_MIN=10
QUIET_HOURS_START=22
QUIET_HOURS_END=6

# Demo Mode & MongoDB Support
DEMO_MODE=true                  # Enables POST /v1/demo/reset and demo quick actions
MONGODB_URL="mongodb://localhost:27017" # Optional MongoDB connection checked by /health

# Storage Directories
DATA_DIR="./data"
UPLOAD_DIR="./data/uploads"

# Default Patient Identifier
DEFAULT_PATIENT_ID=1
