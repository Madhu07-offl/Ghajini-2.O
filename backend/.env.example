PROJECT_NAME="Ghajini 2.0"
API_V1_STR="/v1"
DATABASE_URL="sqlite:///./ghajini.db"

# Face engine similarity thresholds
FACE_T_HIGH=0.50
FACE_T_LOW=0.38

# Ollama LLM Settings
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2:3b"
OLLAMA_TEMPERATURE=0.2
OLLAMA_MAX_TOKENS=120
OLLAMA_TIMEOUT_SECONDS=15.0

# Storage Directories
DATA_DIR="./data"
UPLOAD_DIR="./data/uploads"

# Default Patient Identifier
DEFAULT_PATIENT_ID=1
